{
  "manifest_version": 3,
  "name": "Raven · llenar respuestas",
  "version": "0.7.0",
  "description": "Captura las 60 respuestas del Raven una vez y llénalas en la página de PsicoWeb con un clic. No guarda la página por ti.",
  "icons": {
    "16": "iconos/icono-16.png",
    "32": "iconos/icono-32.png",
    "48": "iconos/icono-48.png",
    "128": "iconos/icono-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.psicoweb.com/*",
    "http://app.psicoweb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Abrir la captura de respuestas"
    },
    "llenar": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Llenar la página del Raven (igual que el botón «Llenar»)"
    }
  },
  "action": {
    "default_title": "Raven · respuestas",
    "default_icon": {
      "16": "iconos/icono-16.png",
      "32": "iconos/icono-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.psicoweb.com/Raven/IntroducirRespuestas*",
        "http://app.psicoweb.com/Raven/IntroducirRespuestas*"
      ],
      "js": [
        "cedula.js",
        "llenar.js",
        "capturas.js",
        "boton.js"
      ]
    }
  ]
}
